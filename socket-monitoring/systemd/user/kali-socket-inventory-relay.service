[Unit]
Description=Private Kind network relay for Kali socket inventory metrics
After=default.target kali-socket-inventory-exporter.service
Requires=kali-socket-inventory-exporter.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f kali-socket-inventory-relay
ExecStart=/usr/bin/docker run --rm --name kali-socket-inventory-relay --network container:devsecops-control-plane --read-only --cap-drop=ALL --security-opt=no-new-privileges -v %h/.local/share/kali-socket-inventory/metrics.sock:/run/socket-inventory.sock:ro alpine/socat:1.8.1.3 tcp-listen:19100,bind=0.0.0.0,reuseaddr,fork unix-connect:/run/socket-inventory.sock
ExecStop=-/usr/bin/docker rm -f kali-socket-inventory-relay
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
