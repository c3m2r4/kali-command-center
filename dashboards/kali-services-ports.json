        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "kali_cc_systemd_failed_units",
          "refId": "A",
          "legendFormat": "{{unit}} {{project}} {{check}} {{container}} {{state}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Prometheus scrape target health",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "up",
          "refId": "A",
          "legendFormat": "{{unit}} {{project}} {{check}} {{container}} {{state}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ],
  "links": [],
  "editable": true
}
