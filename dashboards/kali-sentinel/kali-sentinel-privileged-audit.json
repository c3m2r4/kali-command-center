  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Collection status: not yet evidenced",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Host auditd and Wazuh services were found active, but audit rules, monitored paths, forwarding destination, and root/sudo attribution have not been verified. No privileged activity metrics or detailed log source is currently connected to Grafana. An empty panel is not evidence of no privileged activity."
      }
    },
    {
      "id": 2,
      "title": "Audit-related scrape targets",
      "type": "table",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "expr": "up{job=~\".*(audit|wazuh|loki|alloy).*\"}",
          "refId": "A",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Evidence required",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Root and sudo attribution needs audit records containing original login identity, target identity, executable, session, and result. Process metrics alone cannot reconstruct commands. Wazuh/auditd rules should be reviewed for coverage and duplication before adding any rules."
      }
    }
  ],
