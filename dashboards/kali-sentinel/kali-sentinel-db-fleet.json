{
  "id": null,
  "uid": "kali-sentinel-db-fleet",
  "title": "Kali Sentinel | Database Fleet",
  "tags": [
    "kali-sentinel",
    "database",
    "fleet"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Coverage status",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Verified engines: MariaDB 11.8.8, PostgreSQL-compatible service, Redis, RabbitMQ, and DBCC SQLite metadata. Database performance exporters are absent, so connection utilization, query latency, replication, storage growth, and backup freshness are **not measured here**. MariaDB audit logging was observed disabled."
      }
    },
    {
      "id": 2,
      "title": "Database exporter targets (no series means not instrumented)",
      "type": "table",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "expr": "up{job=~\".*(mysql|mariadb|postgres|redis).*\"}",
          "refId": "A",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Observed MariaDB DAM event totals",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by(event_type)(increase(dbcc_dam_events_total{engine=\"mariadb\"}[1h]))",
          "refId": "A",
          "legendFormat": "{{event_type}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "DBCC stored normalized events",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "dbcc_dam_events_stored",
          "refId": "A",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "title": "Connection details",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "MariaDB: host TCP 3306, wildcard bind; PostgreSQL-compatible backend: loopback 5432; Redis: wildcard host port 6381; RabbitMQ: loopback 5672; DBCC metadata: local SQLite. No database administration web UI was discovered. Review the service catalog for exposure evidence."
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
