    {
      "id": 8,
      "title": "Known gaps",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "MariaDB audit plugin logging is currently OFF; auditd rules and Wazuh coverage remain unverified; Loki/Alloy and database exporters are absent; Prometheus storage is ephemeral. Host journal usage is significant and persistent log retention needs a capacity plan."
      }
    }
