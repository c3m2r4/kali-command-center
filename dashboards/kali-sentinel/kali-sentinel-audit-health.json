{
  "id": null,
  "uid": "kali-sentinel-audit-health",
  "title": "Kali Sentinel | Audit & Monitoring Health",
  "tags": [
    "kali-sentinel",
    "monitoring",
    "integrity"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Read this first",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Interpretation:** Prometheus currently receives the DBCC metrics endpoint and DAM collector heartbeat. These signals confirm exporter reachability and recent collector activity, but do not verify that MariaDB audit logging is still enabled after a database restart, prove event completeness/identity, or make the local hash chain immutable. Normalized event records redact SQL literals; the host journal may retain original statement text. Missing metrics mean a coverage gap, not zero activity."
      }
    },
    {
      "id": 9,
      "title": "Prometheus targets",
      "type": "stat",
      "description": "Number of scrape targets currently represented by the up metric. No data means target telemetry is absent.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "count(up)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Unhealthy targets",
      "type": "stat",
      "description": "Scrape targets with up=0. No data means no target series; check Prometheus before interpreting zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "(count(up == 0) or vector(0)) and (count(up) > 0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "DBCC scrape target",
      "type": "stat",
      "description": "SCRAPED confirms only that Prometheus can read the DBCC metrics endpoint. -1 means the target series is absent.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "TARGET ABSENT",
                  "color": "gray"
                },
                "0": {
                  "text": "FAILED",
                  "color": "red"
                },
                "1": {
                  "text": "SCRAPED",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "min(up{job=\"dbcc-dam-metrics\"}) or vector(-1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "DAM collector heartbeat",
      "type": "stat",
      "description": "The exporter reports whether a collector heartbeat is current (<90s); this does not verify MariaDB audit-plugin state.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "NO DATA",
                  "color": "gray"
                },
                "0": {
                  "text": "STALE",
                  "color": "red"
                },
                "1": {
                  "text": "CURRENT",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "min(dbcc_dam_source_configured{job=\"dbcc-dam-metrics\"}) or vector(-1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Collector heartbeat age",
      "type": "stat",
      "description": "Elapsed time since the collector heartbeat. Green <60s, amber 60–89s, red >=90s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "NO DATA",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "max(time() - dbcc_dam_collector_heartbeat_timestamp_seconds{job=\"dbcc-dam-metrics\"}) or vector(-1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "DAM events stored (total)",
      "type": "stat",
      "description": "Cumulative records stored by the collector metric. No series is shown as NO DATA, not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "NO DATA",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "sum(dbcc_dam_events_stored{job=\"dbcc-dam-metrics\"}) or vector(-1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Prometheus target health",
      "type": "table",
      "description": "Current scrape state for each configured Prometheus target; UP means Prometheus scraped it successfully.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Status",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "expr": "up",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "container": true
            },
            "indexByName": {
              "job": 0,
              "namespace": 1,
              "service": 2,
              "pod": 3,
              "endpoint": 4,
              "instance": 5,
              "Value": 6
            },
            "renameByName": {
              "job": "Job",
              "namespace": "Namespace",
              "service": "Service",
              "pod": "Pod",
              "endpoint": "Endpoint",
              "instance": "Target",
              "Value": "Status"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Active firing alerts",
      "type": "table",
      "description": "Current firing alert instances. Details shown depend on labels supplied by each alert rule.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\",severity!=\"none\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "alertstate": true,
              "cluster": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "pod": true,
              "service": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "project": 2,
              "namespace": 3,
              "exported_container": 4,
              "process_name": 5,
              "local_port": 6,
              "Value": 7
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "project": "Project",
              "namespace": "Namespace",
              "exported_container": "Container",
              "process_name": "Process",
              "local_port": "Port",
              "Value": "Firing"
