{
  "id": null,
  "uid": "kali-sentinel-sockets",
  "title": "Kali Sentinel \u2014 Listening Sockets",
  "tags": [
    "kali-sentinel",
    "network",
    "socket-inventory",
    "security"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "protocol",
        "label": "Protocol",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kali_socket_inventory_last_seen_timestamp_seconds, protocol)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "port",
        "label": "Port",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kali_socket_inventory_last_seen_timestamp_seconds{protocol=~\"$protocol\"}, local_port)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "process",
        "label": "Process",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kali_socket_inventory_last_seen_timestamp_seconds{protocol=~\"$protocol\"}, process_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "address",
        "label": "Local address",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kali_socket_inventory_last_seen_timestamp_seconds{protocol=~\"$protocol\"}, local_address)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "exposure",
        "label": "Exposure",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kali_socket_inventory_last_seen_timestamp_seconds{protocol=~\"$protocol\"}, exposure)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "Collection and evidence limits",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Source:** host `ss -H -ltnup`. The exporter records TCP listeners and UDP sockets, local/peer endpoints, state, owner, interface, bounded application mapping, and last-seen time. **Process/PID are `unavailable` unless the exact sudo rule is installed and process metadata metric is 1.** New/disappeared events use a local baseline and 15-minute TTL; first run establishes baseline. Browser links are populated only from the verified allowlist in `socket-monitoring/config.json`. Health failures include only checks registered in Kali Command Center."
      }
    },
    {
      "id": 1,
      "title": "TCP listening sockets",
      "description": "Current TCP listeners from ss -ltnup.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kali_socket_inventory_sockets{protocol=\"tcp\",socket_state=\"LISTEN\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
