      "id": 1,
      "title": "Interpretation",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Prometheus contains bounded aggregate event categories only. It does not contain statement text, account names, client IPs, object names, or independently verified actor identity. Detailed normalized records are available in [DBCC](http://127.0.0.1:18765/). The current MariaDB audit plugin settings were observed OFF; stored events include historical data and must not be treated as current complete coverage."
      }
    },
