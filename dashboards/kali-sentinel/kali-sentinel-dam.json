{
  "id": null,
  "uid": "kali-sentinel-dam",
  "title": "Kali Sentinel | Database Activity Monitoring",
  "tags": [
    "kali-sentinel",
    "database",
    "dam"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Interpretation",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Prometheus exposes bounded DAM event categories and cumulative collector counters; it excludes statement text, account names, client IPs, and object names. The DBCC scrape and collector heartbeat show endpoint reachability and recent collector-reported activity, but **do not prove MariaDB audit logging is enabled now or that collection is complete**. Audit settings were applied at runtime and must be checked after MariaDB restarts. Detailed normalized records are available in [DBCC](http://127.0.0.1:18765/)."
      }
    },
    {
      "id": 2,
      "title": "DBCC scrape target",
      "type": "stat",
      "description": "SCRAPED proves only that Prometheus can read the DBCC metrics endpoint; it does not verify the MariaDB audit plugin.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "TARGET ABSENT",
                  "color": "gray"
                },
                "0": {
                  "text": "FAILED",
                  "color": "red"
                },
                "1": {
                  "text": "SCRAPED",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "min(up{job=\"dbcc-dam-metrics\"}) or vector(-1)",
          "refId": "A",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "title": "Normalized events stored (total)",
      "type": "stat",
      "description": "Cumulative DBCC count; this is not limited to the dashboard time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "NO DATA",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(dbcc_dam_events_stored{job=\"dbcc-dam-metrics\"}) or vector(-1)",
          "refId": "A",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "title": "Collector heartbeat age",
      "type": "stat",
      "description": "Seconds since the last collector heartbeat. Green below 60s, amber 60–89s, red at 90s or more. This does not verify plugin state.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "NO DATA",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "max(time() - dbcc_dam_collector_heartbeat_timestamp_seconds{job=\"dbcc-dam-metrics\"}) or vector(-1)",
          "refId": "A",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "title": "Collector heartbeat current (not source verification)",
      "type": "stat",
      "description": "The exporter reports whether a collector heartbeat is current (<90 seconds). This does not prove the MariaDB audit plugin is active or events are complete.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "NO DATA",
                  "color": "gray"
                },
                "0": {
                  "text": "STALE",
                  "color": "red"
                },
                "1": {
                  "text": "CURRENT",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "min(dbcc_dam_source_configured{job=\"dbcc-dam-metrics\"}) or vector(-1)",
          "refId": "A",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 6,
      "title": "Observed event rate by category",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by(event_type,outcome)(rate(dbcc_dam_events_total{engine=\"mariadb\",job=\"dbcc-dam-metrics\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{event_type}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Events by category in selected period",
      "type": "timeseries",
      "description": "Rounded counter increases over the selected dashboard time range, grouped by event type.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "round(sum by(event_type)(increase(dbcc_dam_events_total{engine=\"mariadb\",job=\"dbcc-dam-metrics\"}[$__range])))",
          "refId": "A",
          "legendFormat": "{{event_type}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Investigation",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "The host journal can retain original MariaDB audit statements; restrict access and set retention deliberately. DBCC normalizes records and redacts SQL literals before storage. A current exporter scrape and heartbeat do not verify plugin state, source completeness, actor identity, or event outcomes. Prometheus history is limited by cluster retention."
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "DBCC DAM records",
      "url": "http://127.0.0.1:18765/",
      "targetBlank": true,
      "keepTime": true,
      "includeVars": false
    }
  ]
}
