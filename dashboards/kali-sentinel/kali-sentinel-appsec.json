  "panels": [
    {
      "id": 1,
      "title": "Evidence limits",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Current checks establish reachability and some HTTP response status/latency. They do not identify individual request paths, users, or authentication outcomes unless an application log source explicitly records them. No centralized Loki/Alloy pipeline is configured."
      }
    },
    {
      "id": 2,
      "title": "Reachability by discovered check",
      "type": "table",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "expr": "kali_cc_health_check_up",
          "refId": "A",
          "legendFormat": "{{project}} / {{check}}"
        }
      ]
    },
