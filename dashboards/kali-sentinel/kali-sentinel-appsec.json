  "panels": [
    {
      "id": 1,
      "title": "Evidence limits",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Coverage:** endpoint checks show reachability, HTTP response codes, and latency; Kubernetes metrics show container restarts; Prometheus supplies active alert signals. These do not reveal request paths, authenticated users, authorization outcomes, WAF detections, or API audit events. No centralized Loki/Alloy log pipeline is configured. A missing metric is not evidence of zero activity; use the monitored-check and exporter status panels to confirm coverage."
      }
    },
    {
      "id": 7,
      "title": "Monitored checks",
      "type": "stat",
      "description": "Current checks matching the dashboard filters. No data means the exporter series is absent.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
