    {
      "id": 1,
      "title": "Lab project health state",
      "description": "State mapping: 1 healthy, 2 degraded, 3 unknown, 4 unconfigured. GOAD and Aegis have no configured health checks in the current registry.",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "expr": "(kali_cc_project_state{project=~\"floci|mythic|goad|aegis\",state=\"healthy\"} * 1) or (kali_cc_project_state{project=~\"floci|mythic|goad|aegis\",state=\"degraded\"} * 2) or (kali_cc_project_state{project=~\"floci|mythic|goad|aegis\",state=\"unknown\"} * 3) or (kali_cc_project_state{project=~\"floci|mythic|goad|aegis\",state=\"unconfigured\"} * 4)",
          "refId": "A",
          "legendFormat": "{{project}} / {{state}}",
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 1,
          "max": 4,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "gray",
                "value": 4
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "Healthy"
                },
                "2": {
                  "color": "red",
                  "index": 1,
                  "text": "Degraded"
                },
                "3": {
                  "color": "orange",
                  "index": 2,
                  "text": "Unknown"
                },
                "4": {
                  "color": "gray",
                  "index": 3,
                  "text": "Unconfigured"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
